      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Bronze Kafka lag",
      "description": "Messages in Kafka that the bronze job hasn't read yet, on the furthest-behind partition, after its last micro-batch. Each poll publishes about 50 to 150, so a few hundred is a batch in flight; amber from 1,000, red from 10,000.",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(flight_stream_kafka_offsets_behind{query=\"lakehouse.bronze.flight_positions\"})",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1000
              },
              {
                "color": "#d03b3b",
                "value": 10000
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Newest position in silver",
      "description": "Age of the newest event_time silver has written. The producer polls every 4 minutes and each job triggers every 30 seconds, so up to about 6 minutes is normal; amber from 10 minutes, red from 30.",
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(flight_stream_event_time_max_timestamp_seconds{query=\"lakehouse.silver.flight_positions\"})",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
