    {
      "type": "timeseries",
      "title": "Rows per minute",
      "description": "Positions published to Kafka and rows read by each streaming query, averaged over 10 minutes: the producer publishes in bursts every 4 minutes. In steady state every line sits at the same level; a query below the Kafka line is falling behind.",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"flight.positions.v1\"}[10m])) * 60",
          "range": true,
          "instant": false,
          "legendFormat": "published to Kafka"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (query) (rate(flight_stream_input_rows_total[10m])) * 60",
          "range": true,
          "instant": false,
          "legendFormat": "{{query}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "drawStyle": "line",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
