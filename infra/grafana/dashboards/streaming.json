    {
      "type": "timeseries",
      "title": "Event-time freshness",
      "description": "How old the newest event_time each query has read is, and how far its watermark trails real time. The watermark trails the newest event by 15 minutes (silver's late-data allowance), so its line sits about 15 minutes above. Flights read silver, so their line sits a micro-batch behind it.",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - flight_stream_event_time_max_timestamp_seconds",
          "range": true,
          "instant": false,
          "legendFormat": "{{query}} newest event"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - flight_stream_watermark_timestamp_seconds",
          "range": true,
          "instant": false,
          "legendFormat": "{{query}} watermark"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
