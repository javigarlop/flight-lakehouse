      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(kafka_topic_partition_current_offset{topic=\"flight.positions.v1\"}[1h]))",
          "range": false,
          "instant": true
