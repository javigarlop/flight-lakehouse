    {
      "type": "stat",
      "title": "Published in the last hour",
      "description": "Positions the producer published to flight.positions.v1 in the last hour, from the topic's offsets. 15 polls of about 50 to 150 aircraft each; zero means the producer or adsb.lol is down.",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
