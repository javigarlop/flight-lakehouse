    {
      "type": "stat",
      "title": "Flights that held",
      "description": "Flights that circled at least once within 40 km of their arrival airport. Live 4-minute polls are too sparse to see this; replayed full-resolution recordings show it.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT count(*) AS flights FROM lakehouse.gold.holding_patterns WHERE $__timeFilter(landed_at) AND airport_code IN ($airport)",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
