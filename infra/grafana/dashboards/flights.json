        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "geomap",
      "title": "Aircraft in the air",
      "description": "Latest position of each aircraft seen in the last 10 minutes and not on the ground (gold.active_flights, read live from silver). Replayed recordings have old event times, so they show none.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT callsign, registration, aircraft_type, latitude, longitude,\n       baro_altitude, velocity, true_track, duration_s\nFROM lakehouse.gold.active_flights",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 41.297,
          "lon": 2.078,
          "zoom": 7,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": false,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "tooltip": {
          "mode": "details"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Aircraft",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "config": {
              "showLegend": false,
              "style": {
                "color": {
                  "fixed": "#3987e5"
                },
                "opacity": 0.9,
                "size": {
                  "fixed": 8
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/plane.svg"
                },
                "rotation": {
                  "field": "true_track",
                  "mode": "field",
                  "fixed": 0,
                  "min": 0,
                  "max": 360
                },
                "symbolAlign": {
                  "horizontal": "center",
                  "vertical": "center"
                },
                "text": {
                  "field": "callsign",
                  "mode": "field",
                  "fixed": ""
                },
                "textConfig": {
                  "fontSize": 10,
                  "offsetX": 10,
                  "offsetY": 0,
                  "textAlign": "left",
                  "textBaseline": "middle"
                }
              }
