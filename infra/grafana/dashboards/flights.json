    {
      "type": "barchart",
      "title": "Busiest routes",
      "description": "Flights per route in the time range, top 10. 'outside' means that end of the route is beyond the polling area.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT route, sum(flights) AS flights\nFROM lakehouse.gold.route_stats_daily\nWHERE $__dateFilter(flight_date) AND (departure_airport IN ($airport) OR arrival_airport IN ($airport))\nGROUP BY 1 ORDER BY 2 DESC LIMIT 10",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "min": 0,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "flights"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Flights"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "xField": "route",
        "showValue": "auto",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        },
        "xTickLabelSpacing": 0
      },
      "id": 11,
      "gridPos": {
