          "rawSQL": "SELECT callsign, registration, aircraft_type AS type,\n       baro_altitude AS altitude, velocity AS speed, vertical_rate,\n       duration_s, age_s\nFROM lakehouse.gold.active_flights\nORDER BY duration_s DESC",
          "format": 1
