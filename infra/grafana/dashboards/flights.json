        "y": 33,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "table",
      "title": "Route durations",
      "description": "Flights per route and the flight-weighted average of the daily percentiles. Where a route ends 'outside', the duration is the time spent inside the polling area.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT route, sum(flights) AS flights,\n       sum(p25_duration_s * flights) / sum(flights) AS p25,\n       sum(median_duration_s * flights) / sum(flights) AS median,\n       sum(p75_duration_s * flights) / sum(flights) AS p75\nFROM lakehouse.gold.route_stats_daily\nWHERE $__dateFilter(flight_date) AND (departure_airport IN ($airport) OR arrival_airport IN ($airport))\nGROUP BY 1 ORDER BY 2 DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
