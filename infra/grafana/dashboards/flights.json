    {
      "type": "timeseries",
      "title": "Movements per hour",
      "description": "Departures and arrivals, stacked, so each bar is the hour's total movements at the selected airports (UTC). Flights are matched to airports by silver. From gold.airport_traffic_hourly, rebuilt every 15 minutes.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT hour_start AS time, sum(departures) AS departures, sum(arrivals) AS arrivals\nFROM lakehouse.gold.airport_traffic_hourly\nWHERE $__timeFilter(hour_start) AND airport_code IN ($airport)\nGROUP BY 1 ORDER BY 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 8,
            "drawStyle": "bars",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "barAlignment": -1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "departures"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "arrivals"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "departures"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Departures"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "arrivals"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Arrivals"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 16,
        "h": 9
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "table",
      "title": "Totals by airport",
      "description": "Totals for the time range, busiest airport first.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT t.airport_code AS airport, a.name, sum(t.departures) AS departures,\n       sum(t.arrivals) AS arrivals\nFROM lakehouse.gold.airport_traffic_hourly AS t\nLEFT JOIN lakehouse.reference.airports AS a ON t.airport_code = a.airport_code\nWHERE $__timeFilter(t.hour_start) AND t.airport_code IN ($airport)\nGROUP BY 1, 2\nORDER BY sum(t.departures) + sum(t.arrivals) DESC",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "airport"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Airport"
              },
              {
                "id": "custom.width",
                "value": 70
