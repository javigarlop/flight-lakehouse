{
  "uid": "gold-flights",
  "title": "Flights",
  "description": "Traffic around the polling area from the gold tables, read through Trino.",
  "tags": [
    "gold"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "airport",
        "label": "Airport",
        "type": "query",
        "datasource": {
          "type": "trino-datasource",
          "uid": "trino"
        },
        "query": {
          "refId": "TrinoDataSource-QueryVariable",
          "rawSQL": "SELECT DISTINCT airport_code FROM lakehouse.gold.airport_traffic_hourly ORDER BY 1"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
