{
  "uid": "gold-pipeline-freshness",
  "title": "Pipeline freshness",
  "description": "How far behind real time the gold tables are, from gold.pipeline_freshness, and which schema versions bronze is receiving.",
  "tags": [
    "gold"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "utc",
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 2,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "gold"
      ],
      "title": "Gold dashboards",
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Data age at the last dbt run",
      "description": "How old the newest position in silver was when the last dbt run read it. dbt runs every 15 minutes and the producer polls every 4, so up to about 20 minutes is normal; amber from 30 minutes, red from 1 hour.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT event_to_gold_s FROM lakehouse.gold.pipeline_freshness ORDER BY measured_at DESC LIMIT 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1800
              },
              {
                "color": "#d03b3b",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "stat",
      "title": "Last dbt run",
      "description": "When dbt last built the gold tables.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT max(measured_at) AS measured_at FROM lakehouse.gold.pipeline_freshness",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^measured_at$/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "stat",
      "title": "Positions in the last hour",
      "description": "Positions silver held for the hour before the last dbt run.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT positions_last_hour FROM lakehouse.gold.pipeline_freshness ORDER BY measured_at DESC LIMIT 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3987e5",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "timeseries",
      "title": "Data age at each dbt run",
      "description": "Age of the newest position in silver, measured at each dbt run. The dashed lines are the stat's 30-minute and 1-hour thresholds.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT measured_at AS time, event_to_gold_s AS data_age\nFROM lakehouse.gold.pipeline_freshness\nWHERE $__timeFilter(measured_at)\nORDER BY 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 8,
            "drawStyle": "line",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0ca30c",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1800
              },
              {
                "color": "#d03b3b",
                "value": 3600
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "data_age"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Data age"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "timeseries",
      "title": "Ingest latency, event to bronze",
      "description": "Time from the aircraft's position report to its arrival in bronze, over the hour before each dbt run. Empty when no positions arrived in that hour.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT measured_at AS time, p50_ingest_latency_s AS p50, p95_ingest_latency_s AS p95\nFROM lakehouse.gold.pipeline_freshness\nWHERE $__timeFilter(measured_at)\nORDER BY 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 8,
            "drawStyle": "line",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Median"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "95th percentile"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "timeseries",
      "title": "Positions per hour",
      "description": "Positions silver held for the hour before each dbt run.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT measured_at AS time, positions_last_hour AS positions\nFROM lakehouse.gold.pipeline_freshness\nWHERE $__timeFilter(measured_at)\nORDER BY 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "always",
            "pointSize": 8,
            "drawStyle": "line",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "barAlignment": -1,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "positions"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Positions"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "trino-datasource",
        "uid": "trino"
      }
    },
    {
      "type": "timeseries",
      "title": "Positions by schema version",
      "description": "Bronze rows per hour by the Avro schema version that wrote them, stacked. v1 and v2 share the topic during a schema change (make schema-demo); undecoded rows match no known version and go to silver.rejected_positions. Rows from before bronze recorded versions count as v1.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "trino-datasource",
            "uid": "trino"
          },
          "rawSQL": "SELECT date_trunc('hour', ingested_at) AS time,\n  count_if(icao24 IS NOT NULL AND coalesce(schema_version, 1) = 1) AS v1,\n  count_if(schema_version = 2) AS v2,\n  count_if(icao24 IS NULL) AS undecoded\nFROM lakehouse.bronze.flight_positions\nWHERE $__timeFilter(ingested_at)\nGROUP BY 1 ORDER BY 1",
          "format": 1
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "pointSize": 8,
            "drawStyle": "bars",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "barAlignment": -1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "v1"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "v2"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0ca30c"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "undecoded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
