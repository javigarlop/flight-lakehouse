            "showPoints": "auto",
            "pointSize": 8,
            "drawStyle": "line",
            "spanNulls": false,
            "axisSoftMin": 0,
            "gradientMode": "none",
            "barAlignment": -1
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
