# Copy to .env (make up does this for you). Never commit .env.
# The values below are for the local Compose stack only.

# SeaweedFS S3 credentials and the bucket that holds the Iceberg warehouse.
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-secret
S3_BUCKET=warehouse

# Polaris root principal (bootstrapped on start) and the Iceberg catalog name.
POLARIS_CLIENT_ID=root
POLARIS_CLIENT_SECRET=polaris-secret
POLARIS_CATALOG=lakehouse

# Host ports (bound to 127.0.0.1). Change them if they clash with other local services.
KAFKA_HOST_PORT=9094
REGISTRY_HOST_PORT=8081
S3_HOST_PORT=8333
POLARIS_HOST_PORT=8181
SEAWEEDFS_FILER_HOST_PORT=8888
SEAWEEDFS_MASTER_HOST_PORT=9333
KAFKA_UI_HOST_PORT=8085
REGISTRY_UI_HOST_PORT=8086

# Area and polling (defaults: 100 nm around Barcelona airport, every 4 minutes).
# adsb.lol allows 500 requests/day; keep POLL_INTERVAL_SECONDS at 180 or more.
# AREA_LATITUDE=41.297
# AREA_LONGITUDE=2.078
# AREA_RADIUS_NM=100
# POLL_INTERVAL_SECONDS=240

# adsb.lol: no key needed today. Not sent yet; reserved for a future feeder key.
ADSBLOL_API_KEY=

# OpenSky (optional second producer): OAuth2 client credentials.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
